# Copy this file to .env.local if you need these settings.

# Leave DATABASE_URL unset for local development: the app then uses a built-in
# local Postgres (PGlite) stored in the ./.data folder. No install needed.
# On Vercel it MUST be set (Vercel > Storage > Neon adds it for you).
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: set to protect the whole site with a shared password.
# Browser will prompt; any username works, password must match.
APP_PASSWORD=""
